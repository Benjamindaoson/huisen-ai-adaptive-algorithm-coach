{
  "name": "huawei-od-learning-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "archive:sources": "node scripts/archive-sources.mjs",
    "build:corpus": "node scripts/build-corpus.mjs",
    "build:mentor-index": "node scripts/build-mentor-index.mjs",
    "quality:golden": "node scripts/check-golden-quality.mjs",
    "test": "vitest run",
    "lint": "npm --prefix web run lint",
    "typecheck": "npm --prefix web run typecheck && npm --prefix services/runner/gateway run typecheck",
    "build:web": "npm --prefix web run build",
    "verify": "npm run test && npm run lint && npm run build:corpus && npm run quality:golden && npm run build:corpus && npm run build:mentor-index && npm run typecheck && npm run build:web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "mammoth": "^1.12.1"
  }
}
