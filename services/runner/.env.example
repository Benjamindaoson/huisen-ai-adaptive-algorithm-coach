# Copy this file to .env and replace both passwords before exposing the gateway beyond localhost.
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=replace-with-a-long-unique-postgres-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-unique-redis-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Judge0's own limits: the gateway additionally enforces the same limits.
JUDGE0_TELEMETRY_ENABLE=false
ENABLE_WAIT_RESULT=true
ENABLE_COMPILER_OPTIONS=false
ENABLE_COMMAND_LINE_ARGUMENTS=false
ENABLE_CALLBACKS=false
ENABLE_ADDITIONAL_FILES=false
# Docker Desktop commonly exposes cgroups v2 while Judge0 1.13.1 expects
# cgroups v1. Per-process limits keep isolate bounded without --cg.
ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=true
ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=true
ALLOW_ORIGIN=
ALLOW_IP=
CPU_TIME_LIMIT=5
MAX_CPU_TIME_LIMIT=5
CPU_EXTRA_TIME=0.1
MAX_CPU_EXTRA_TIME=0.1
WALL_TIME_LIMIT=10
MAX_WALL_TIME_LIMIT=10
MEMORY_LIMIT=2048000
MAX_MEMORY_LIMIT=2048000
MAX_FILE_SIZE=1024
MAX_MAX_FILE_SIZE=1024
ALLOW_ENABLE_NETWORK=false
ENABLE_NETWORK=false
COUNT=2
MAX_QUEUE_SIZE=20
RAILS_ENV=production

# Browser-facing gateway settings. Change the origin when deploying a public static site.
RUNNER_ALLOWED_ORIGIN=http://127.0.0.1:4173,http://127.0.0.1:4174,http://127.0.0.1:4175
# Judge0 reads this shared config and must listen on its internal API port.
# Docker Compose overrides only the gateway to GATEWAY_PORT.
PORT=2358
GATEWAY_PORT=8787
JUDGE0_URL=http://judge0-server:2358
JUDGE0_LANGUAGE_JAVA=62
JUDGE0_LANGUAGE_PYTHON=71
JUDGE0_LANGUAGE_JAVASCRIPT=63
JUDGE0_LANGUAGE_CPP=54

# Optional evidence-grounded AI tutor. These values are read only by the gateway.
# AI_API_URL must expose an OpenAI-compatible /chat/completions endpoint.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Agentic learning state. Docker Compose mounts /data as a persistent volume.
LEARNING_DATA_FILE=/data/learning.json

# Single dynamic Mentor Agent. Keep the key server-side; never prefix it with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MENTOR_DATA_FILE=/data/mentor.json
# PostgreSQL mode activates only when MENTOR_PG_HOST is set. The remaining
# values default to the server-only POSTGRES_* variables above.
MENTOR_PG_HOST=db
MENTOR_PG_PORT=5432
MENTOR_AUTH_SECRET=
